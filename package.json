{
  "name": "observatory",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Observatory API",
  "scripts": {
    "arch": "depcruise server/src --config .dependency-cruiser.cjs",
    "build": "bun bundler.ts",
    "db:generate": "bun --bun drizzle-kit generate --config server/src/common/database/config.ts",
    "db:migration": "bun run server/src/common/database/migrate.ts",
    "db:push": "bun --bun drizzle-kit push --config server/src/common/database/config.ts",
    "db:update": "bun run db:generate && bun run db:push",
    "dev": "NODE_ENV=development bun run --watch server/src/index.ts",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "lint": "eslint --fix",
    "setup": "bun run docker:dev && bun run db:update",
    "start": "NODE_ENV=production bun run server/src/index.ts",
    "test": "docker-compose -f docker-compose.tests.yml up -d && bun test --env-file=.env.test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.4",
    "@elysia/cors": "2.0.0-rc.1",
    "@elysia/openapi": "2.0.0-rc.1",
    "@elysia/opentelemetry": "2.0.0-rc.0",
    "@elysia/server-timing": "2.0.0-rc.0",
    "@observatory/beatmaps": "workspace:*",
    "@observatory/calculator": "workspace:*",
    "@observatory/common": "workspace:*",
    "@observatory/docs": "workspace:*",
    "@observatory/mirrors": "workspace:*",
    "@observatory/stats": "workspace:*",
    "@observatory/storage": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.2",
    "@opentelemetry/host-metrics": "^0.40.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "drizzle-orm": "^0.35.3",
    "elysia": "2.0.0-rc.4",
    "elysia-ip": "2.0.0",
    "elysia-rate-limit": "5.1.2",
    "exact-mirror": "^1.2.7",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino-loki": "^2.3.1",
    "pino-pretty": "^11.3.0",
    "rosu-pp-js": "npm:@richardscull/rosu-pp-js@4.0.1-experimental.3",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@richardscull/eslint-config": "^1.0.5",
    "@types/adm-zip": "^0.5.6",
    "@types/bun": "^1.3.4",
    "@types/pg": "^8.11.10",
    "bun-plugin-pino": "1.5.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.26.2",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "overrides": {
    "@opentelemetry/sdk-node": "0.223.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "workspaces": [
    "server/src/common",
    "server/src/modules/*"
  ]
}
